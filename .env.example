# Copy to .env — never commit the real file. Loaded automatically (engine/config.py),
# so the launchd service picks these up even though it inherits no shell environment.

# ---- Model judgment (optional) ----------------------------------------------
# Without this, the pipeline runs fully and every judgment field reads
# "[STUB: no API key — judgment unavailable]". Computed scoring is unaffected.
NVIDIA_API_KEY=

# Apify — scraped funding discovery + company self-description crawl.
# Get it at apify.com -> Settings -> Integrations -> Personal API token.
# Unset = the Apify source stays switched off and says so; nothing is invented.
APIFY_TOKEN=

# ---- Email delivery (Resend) -------------------------------------------------
# https://resend.com -> API Keys. Free tier needs no domain: you send from
# onboarding@resend.dev and can deliver to the address on your Resend account.
# Verify a domain to send to partners, then change DIGEST_FROM.
RESEND_API_KEY=
DIGEST_TO=saumya.mimo2003@gmail.com
DIGEST_FROM=Thirdbase Deal Engine <onboarding@resend.dev>

# ---- Live Google Sheet mirror (optional) -------------------------------------
# Service-account JSON key path. See RUNBOOK.md § Google Sheets for the 5-minute setup.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Either point at a sheet you already shared with the service-account email…
GSHEET_ID=
# …or let it create one by title and share it with you:
GSHEET_TITLE=Thirdbase Deal Pipeline
GSHEET_SHARE_WITH=saumya.mimo2003@gmail.com

# ---- Web server --------------------------------------------------------------
# 127.0.0.1 keeps fund data off the network. Change only if you mean to expose it.
DEAL_ENGINE_HOST=127.0.0.1
DEAL_ENGINE_PORT=8787

# ---- Licensed data sources (all optional; adapters return LicenseRequired) ----
PITCHBOOK_API_KEY=
CRUNCHBASE_API_KEY=
HARMONIC_API_KEY=
DEALROOM_API_KEY=
CORESIGNAL_API_KEY=
X_BEARER_TOKEN=
BLIND_API_KEY=
PODCAST_API_KEY=
SUBSTACK_API_KEY=
THEINFORMATION_API_KEY=
