<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by deploy/install.sh into ~/Library/LaunchAgents/; the placeholder
     tokens below become absolute paths on this machine. A LaunchAgent (not a
     Daemon) is correct here: it runs as the logged-in user, which is what the
     fund data and the ~/.env belong to. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.thirdbase.dealengine</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__DIR__/serve.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>PATH</key>
    <string>__DIR__/.venv/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Start at login and keep it up. On a laptop, sleep suspends the process and
       wake resumes it; APScheduler is configured with coalesce + a 6h misfire
       grace, and serve.py runs a digest catch-up on startup, so a missed
       Mon/Wed/Fri send is picked up rather than skipped. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>__DIR__/logs/engine.out.log</string>
  <key>StandardErrorPath</key>
  <string>__DIR__/logs/engine.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
